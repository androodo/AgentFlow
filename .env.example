# Local development credentials. Change passwords before sharing any instance.
POSTGRES_PASSWORD=northstar-local-admin
APP_DB_PASSWORD=northstar-local-app
READER_DB_PASSWORD=northstar-local-reader
WEB_PORT=3001
API_PORT=8001
MCP_PORT=8002

# Opt in only after installing Ollama and explicitly pulling a model on the host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=45
# Set to a locally installed Ollama model to enable quality judging.
OLLAMA_JUDGE_MODEL=

# Optional metadata-only export to LangSmith. External traffic is opt-in.
AGENTFLOW_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentflow

# Optional hosted inference. Choose a model supported by your provider account.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AGENTFLOW_JUDGE_PROVIDER=ollama
